    movej(get_inverse_kin(convert_pose(Point_1.p, Point_1.frame, "base"), qnear=Point_1.q), a=acc, v=vel)
    Loop = Loop + 1
  end
  $ 15 "ur-loop"
  Loop_1 = 0
  while (Loop_1 < 2):
    $ 16 "ur-joint-move"
    set_tcp(p[0, 0, 0, 0, 0, 0], "Tool_flange")
    movej(get_inverse_kin(convert_pose(Point.p, Point.frame, "base"), qnear=Point.q), a=acc, v=vel)
    $ 17 "ur-wait"
    sleep(0.75)
    $ 18 "ur-joint-move"
