    movej(get_inverse_kin(convert_pose(Point_4.p, Point_4.frame, "base"), qnear=Point_4.q), a=acc, v=vel)
    $ 21 "ur-wait"
    sleep(0.75)
    $ 22 "ur-joint-move"
