$ 1 "ur-program"
$ 2 "ur-modules"
$ 3 "ur-functions"
$ 4 "ur-before-start"
$ 5 "ur-assignment"
global vel = 100
$ 6 "ur-assignment"
global acc = 100
$ 7 "ur-code"
while (True):
  $ 8 "ur-script"
  write_output_float_register(1,vel)
  $ 9 "ur-script"
  write_output_float_register(2,acc)
  $ 10 "ur-loop"
  Loop = 0
  while (Loop < 2):
    $ 11 "ur-wait"
    sleep(0.75)
    $ 12 "ur-joint-move"
    set_tcp(p[0, 0, 0, 0, 0, 0], "Tool_flange")
    movej(get_inverse_kin(convert_pose(Point_2.p, Point_2.frame, "base"), qnear=Point_2.q), a=acc, v=vel)
    $ 13 "ur-wait"
